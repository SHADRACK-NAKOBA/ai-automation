# ============================================================
# AI AUTOMATION PLATFORM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git — only commit .env.example
# ============================================================

# --- AI Provider (Required) ---
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1000

# --- ServiceNow (Required) ---
# Get your PDI URL from developer.servicenow.com
SNOW_BASE_URL=https://YOUR_INSTANCE.service-now.com
SNOW_USERNAME=admin
SNOW_PASSWORD=YOUR_PDI_PASSWORD
# OR use a token:
# SNOW_TOKEN=YOUR_BASIC_AUTH_TOKEN

# --- Confidence Thresholds ---
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
# Tickets below this confidence get flagged for human review only

# --- Feature Flags ---
DRY_RUN=true
# Set to false only when you're ready to write to ServiceNow
AUTO_APPLY_P1=false
# ALWAYS keep false — P1s need human eyes first

# --- Notifications (Optional) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/HERE

# --- Database ---
DB_PATH=data/metrics.db
# SQLite for local dev. In production: postgresql://user:pass@host/db

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Scheduler ---
CLASSIFIER_POLL_INTERVAL_MINUTES=5
